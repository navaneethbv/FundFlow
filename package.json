{
  "name": "fundflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:palette": "node scripts/validate_palette.js app/globals.css",
    "backfill:institution-logos": "node --env-file=.env.local --experimental-strip-types scripts/backfill-institution-logos.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "plaid": "^48.0.0",
    "re2js": "^2.8.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-plaid-link": "^5.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "fast-glob": "file:./tooling/next-lint-glob",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.4.1": {
      "fast-glob": "$fast-glob"
    },
    "postcss": "^8.5.23",
    "js-yaml": "^4.3.2"
  }
